{
  "name": "codejournal",
  "displayName": "Code Journal",
  "description": "For keeping personal notes or comments at the file or line level",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codejournal.addComment",
        "title": "Add Comment"
      },
      {
        "command": "codejournal.updateComment",
        "title": "Update Comment"
      },
      {
        "command": "codejournal.deleteComment",
        "title": "Delete Comment"
      },
      {
        "command": "codejournal.showComment",
        "title": "Show Comment"
      }
    ],
    "submenus": [
      {
        "id": "codejournal.context",
        "label": "Code Journal"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "codejournal.context",
          "group": "codejournalCustomGroup"
        }
      ],
      "codejournal.context": [
        {
          "command": "codejournal.addComment",
          "group": "1_firstGroup"
        },
        {
          "command": "codejournal.updateComment",
          "group": "1_firstGroup"
        },
        {
          "command": "codejournal.deleteComment",
          "group": "1_firstGroup"
        },
        {
          "command": "codejournal.showComment",
          "group": "1_firstGroup"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}